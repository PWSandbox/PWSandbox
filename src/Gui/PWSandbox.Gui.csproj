<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(TargetFramework)-windows</TargetFramework>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <Product>PWSandbox</Product>
    <Copyright>Copyright (c) 2024-2026 yarb00</Copyright>
    <AssemblyTitle>$(Product)</AssemblyTitle>
    <VersionPrefix>1.6.0</VersionPrefix>
    <RootNamespace>PWSandbox.Gui</RootNamespace>

    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <DefineConstants>NATIVE_AOT</DefineConstants>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Formats/PWSandbox.Formats.csproj" />

    <Content Include="localizations/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
